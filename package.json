    "@radix-ui/react-dialog": "^1.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "better-auth": "^1.7.17",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "prisma": "^6.19.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.1.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
